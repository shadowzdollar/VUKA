# Copy to .env.local. All optional.

# Dev only: where `npm run dev` proxies /api and /healthz (default http://localhost:8080).
VUKA_API_PROXY_TARGET=http://localhost:8080

# Production / separate-origin deployments: absolute engine URL. Leave empty to use same-origin /api.
# The engine must list this UI's origin in VUKA_CORS_ORIGINS (credentials are only allowed for an explicit list).
VITE_API_BASE_URL=

# Default escrow contract + chain for the operator pages (also editable in the UI).
VITE_ESCROW_CONTRACT=
VITE_ESCROW_CHAIN_ID=80002

# Public origin of this site (no trailing slash). Enables absolute og:image / twitter:image URLs.
VITE_PUBLIC_URL=
# Contact addresses shown on /about, /security and /privacy. Until set, those pages show a visible placeholder.
VITE_CONTACT_EMAIL=
VITE_SECURITY_EMAIL=
