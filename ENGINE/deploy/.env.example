# Copy this file to ../.env (ENGINE/deploy/.env) and fill in your values.
# The real .env is gitignored — never commit it.
#
# Used by ENGINE/deploy/docker-compose.yml (local dev Postgres on 5433).
# For Render: put the equivalents in Render's dashboard env vars instead,
# and use the DSN Render generates for the database.

POSTGRES_USER=vuka
POSTGRES_PASSWORD=replace-with-your-local-dev-password
POSTGRES_DB=vuka

# Go engine connection string for the host-mapped PostgreSQL service.
# The reconcile-run target loads this file before starting the engine.
VUKA_DATABASE_URL=postgres://vuka:replace-with-your-local-dev-password@localhost:5433/vuka?sslmode=disable

# Runtime environment: development, staging, or production.
VUKA_ENV=development
VUKA_READ_ONLY=false
# Development-only local ledger rail. This enables successful synthetic
# transfers without enabling settlement or contacting an external provider.
VUKA_LOCAL_SYNTHETIC_EXECUTION_ENABLED=true
# Local demo login password used by `make demo-seed`; never use this outside
# a disposable development database.
VUKA_DEMO_TRADER_PASSWORD=vuka-demo-2026
# Test-only synthetic transaction authorization PIN; never use with a live provider.

# Optional operator authentication for the read-only operations console.
# Set both values to enable login and protect reconciliation read APIs.
# Use a strong password and keep these values out of source control.
VUKA_OPERATOR_EMAIL=operator@example.com
VUKA_OPERATOR_PASSWORD=replace-with-a-strong-password
VUKA_OPERATOR_ROLE=operator
# Provider credential reference only; never put a token/secret here.
# Simulated adapters ignore this value. Real adapters require an activation
# review and a managed reference such as env://VUKA_MTN_CREDENTIALS or
# vault://payments/mtn-rw; external calls remain disabled by default.
VUKA_PROVIDER_CREDENTIAL_REF=
# Provider workflow execution remains sandbox-only until credentials,
# provider activation review, and operator approvals are present.
# Optional read window for activity view/export. Records are never deleted.
VUKA_ACTIVITY_RETENTION_DAYS=0

# Optional local-only dispute workflow fixture credentials.
# Required only for: make -C ENGINE seed-dispute
VUKA_SEED_ARBITER_EMAIL=arbiter@example.com
VUKA_SEED_ARBITER_PASSWORD=replace-with-a-local-test-password
VUKA_SEED_OPERATOR_EMAIL=approval-operator@example.com
VUKA_SEED_OPERATOR_PASSWORD=replace-with-another-local-test-password

# Optional v2 Polygon escrow reconciliation worker.
VUKA_RECONCILIATION_ENABLED=false
VUKA_RECONCILIATION_RPC_URL=
VUKA_RECONCILIATION_CHAIN_ID=80002
VUKA_RECONCILIATION_CONTRACT=
VUKA_RECONCILIATION_CONFIRMATIONS=128
VUKA_RECONCILIATION_INTERVAL_MS=15000
VUKA_RECONCILIATION_MAX_RANGE=9
VUKA_RECONCILIATION_LAG_WARNING_BLOCKS=50
VUKA_RECONCILIATION_LAG_CRITICAL_BLOCKS=500

# Safety gates: production must remain read-only and settlement disabled.
VUKA_SETTLEMENT_GLOBAL_KILL_SWITCH=true
VUKA_SETTLEMENT_EXECUTION_ENABLED=false