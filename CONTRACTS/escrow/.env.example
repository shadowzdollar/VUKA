# Polygon Amoy deployment configuration.
# Copy to .env locally; never commit the populated file.
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGONSCAN_API_KEY=

# Use a dedicated deployer wallet for testnet operations.
VUKA_DEPLOYER_PRIVATE_KEY=

# ERC-20 settlement token deployed on Polygon Amoy.
VUKA_SETTLEMENT_TOKEN=

# Address authorized to resolve disputes.
VUKA_ESCROW_ARBITER=

# --- VukaEscrowV2 (script/DeployVukaEscrowV2.s.sol) -------------------------------------------
# No defaults for authorities: fill every one. Use multisigs for ADMIN and ARBITER.
VUKA_SETTLEMENT_TOKEN=0xREPLACE_WITH_SETTLEMENT_TOKEN
VUKA_ESCROW_ADMIN=0xREPLACE_WITH_GOVERNANCE_MULTISIG
VUKA_ESCROW_GUARDIAN=0xREPLACE_WITH_OPS_PAUSE_KEY
VUKA_ESCROW_ARBITER=0xREPLACE_WITH_ARBITER_MULTISIG
VUKA_ESCROW_TREASURY=0xREPLACE_WITH_TREASURY
# VUKA_ESCROW_FORWARDER=0x...        # optional EIP-2771 forwarder
# VUKA_ESCROW_FEE_BPS=50             # optional, hard cap 100
# VUKA_ESCROW_DISPUTE_WINDOW_SECONDS=2592000
# VUKA_ESCROW_MIN_TIMEOUT_SECONDS=86400
